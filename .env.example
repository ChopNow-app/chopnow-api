# --- App ---
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001

# --- Database (Postgres + PostGIS) ---
DATABASE_URL=postgresql://chopnow:chopnow@localhost:5432/chopnow?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
# Replace these placeholders before running in production. Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=dev_access_secret_replace_me_with_64_random_bytes
JWT_REFRESH_SECRET=dev_refresh_secret_replace_me_with_64_random_bytes
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=30d

# --- Twilio (OTP — Story 1.1) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=+1234567890

# --- Campay (Payments — Story 3.3) ---
CAMPAY_API_URL=https://demo.campay.net/api
CAMPAY_USERNAME=your_campay_username
CAMPAY_PASSWORD=your_campay_password
CAMPAY_WEBHOOK_SECRET=replace_me

# --- Web Push (Story 1.11) ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=replace_me
VAPID_PRIVATE_KEY=replace_me
VAPID_SUBJECT=mailto:ops@chopnow.app

# --- Cloudflare R2 (Media) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=chopnow-media

# --- Throttling ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,https://chopnow.app
