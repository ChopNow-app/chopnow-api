# --- App ---
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001

# --- Database (Postgres + PostGIS) ---
# connection_limit: cap concurrent connections per Prisma client. Default
#   is `num_cpus * 2 + 1`, which on a 2-vCPU droplet is ~5 — too low under
#   load. 20 lines up with Postgres' default max_connections=100 and gives
#   headroom for BullMQ workers + cron jobs that share the client.
# pool_timeout: how long a request waits for a free connection before
#   failing fast. 20s matches the default but makes the policy explicit.
# statement_timeout: server-side cap on any single query. 30s prevents a
#   runaway query from holding a connection indefinitely.
DATABASE_URL=postgresql://chopnow:chopnow@localhost:5432/chopnow?schema=public&connection_limit=20&pool_timeout=20&statement_timeout=30000

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
# DO NOT use these as-is. Run: ./scripts/generate-secrets.sh
# (writes cryptographically random values into .env — .env is gitignored)
JWT_ACCESS_SECRET=REPLACE_ME_RUN_scripts_generate_secrets_sh
JWT_REFRESH_SECRET=REPLACE_ME_RUN_scripts_generate_secrets_sh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# At-rest envelope encryption for admin TOTP shared secrets. Generate with:
#   openssl rand -hex 32
# Rotating this key invalidates every existing ciphertext — affected admins
# must re-enroll via recovery codes. Required in all environments.
APP_SECRET_ENVELOPE_KEY=REPLACE_ME_RUN_scripts_generate_secrets_sh

# --- Twilio (OTP — Story 1.1) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=+1234567890
# Public URL Twilio POSTs delivery status to. Leave empty in dev (no public URL);
# rows then stay at SENT. In prod set to e.g. https://api.chopnow.app/api/twilio/status
TWILIO_STATUS_CALLBACK_URL=

# Local smoke-test escape hatch — when set to "true", OTPs log to the
# backend console instead of being delivered via Twilio. Useful when
# testing against seeded numbers you don't own. NEVER set in production.
OTP_DEV_BYPASS=

# --- Campay (Payments — Story 3.3) ---
CAMPAY_API_URL=https://demo.campay.net/api
CAMPAY_USERNAME=your_campay_username
CAMPAY_PASSWORD=your_campay_password
CAMPAY_WEBHOOK_SECRET=replace_me

# --- Web Push (Story 1.11) ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=replace_me
VAPID_PRIVATE_KEY=replace_me
VAPID_SUBJECT=mailto:ops@chopnow.app

# --- Cloudflare R2 (Media) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=chopnow-media

# --- Mail (Resend — Story 1.12 admin password reset) ---
RESEND_API_KEY=
MAIL_FROM=ChopNow <noreply@chopnow.app>

# --- Throttling ---
# Per-env tiering (window stays at 60s everywhere; only the limit varies):
#   dev      → 1000 — headroom for hot-reload loops + e2e suites
#   staging  → 200  — tighter so pilot smoke tests catch regressions
#   prod     → 100  — actual user-facing limit
# Wired into ThrottlerModule via EnvService in app.module.ts; storage is
# Redis-backed (@nest-lab/throttler-storage-redis), so counters survive
# restarts and stay consistent across replicas.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=1000

# --- Trust proxy ---
# Number of reverse-proxy hops in front of the API. Express ignores
# X-Forwarded-For unless this is set, so per-IP @Throttle decorators
# and audit-log client IPs only work when this matches the deploy.
#   0 — local dev (no proxy in front of Nest)
#   1 — single Caddy / nginx (staging droplet, future Hetzner prod)
#   2 — Cloudflare → Caddy → API
TRUST_PROXY=0

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,https://chopnow.app

# --- Sentry / observability (Phase O1) ---
# All optional. Leave empty in dev — the SDK no-ops cleanly with no DSN.
# Get a DSN from sentry.io → Settings → Projects → chopnow-api → Client Keys (DSN).
SENTRY_DSN=
# Tags every event with this environment label so issues sort by env.
SENTRY_ENVIRONMENT=
# Optional release identifier — set to the git SHA in CD so issues
# link to a specific deploy.
SENTRY_RELEASE=
# Fraction of transactions to capture for performance traces. 0.1 = 10%.
SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional bearer-token gate on GET /metrics. Leave empty in dev (the
# endpoint serves freely). In any deploy where /metrics is reachable
# from outside the trust boundary, set this so only your scraper can
# fetch it. Generate with: openssl rand -hex 32.
METRICS_AUTH_TOKEN=

# --- Prisma slow-query log threshold (Phase O4) ---
# Queries slower than this (ms) emit a structured `prisma_slow_query`
# warn-level log line. Default 500. Tighten to 200 once we have a
# baseline; loosen to 1000 during incident triage to cut log volume.
PRISMA_SLOW_QUERY_MS=500

# --- Grafana Cloud Loki log shipping (Phase O3) ---
# All optional. When LOKI_URL is empty, logs go to stdout only.
# To activate:
#   1. sign up at grafana.com, create a stack
#   2. find the Loki endpoint + numeric tenant ID + an API token with
#      `logs:write` scope
#   3. populate all three. The pino-loki transport ships every log
#      line as a Loki stream entry with labels {app, env}.
LOKI_URL=
LOKI_USERNAME=
LOKI_TOKEN=
