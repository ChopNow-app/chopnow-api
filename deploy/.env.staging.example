# Template for the .env file the CI deploy job materialises on the droplet at
# /opt/chopnow/staging/.env. Real values come from the `staging` GitHub
# environment secrets — never commit a populated copy.

NODE_ENV=production
PORT=3001
APP_URL=http://157.230.125.224:3001

DB_PASSWORD=__from_STAGING_DB_PASSWORD__
# DB hardening — explicit pool + timeouts. See .env.example for the
# rationale on each parameter.
DATABASE_URL=postgresql://chopnow:${DB_PASSWORD}@db:5432/chopnow?schema=public&connection_limit=20&pool_timeout=20&statement_timeout=30000

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=__from_STAGING_JWT_ACCESS_SECRET__
JWT_REFRESH_SECRET=__from_STAGING_JWT_REFRESH_SECRET__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# At-rest envelope encryption for admin TOTP shared secrets (Phase A1).
APP_SECRET_ENVELOPE_KEY=__from_STAGING_APP_SECRET_ENVELOPE_KEY__

# Twilio: not configured for staging yet. The OTP path will run in dev-log
# mode (no real WhatsApp send) until we add credentials here.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
TWILIO_STATUS_CALLBACK_URL=

# Campay / VAPID / R2 / Resend: skipped for first deploy. Add when each
# story needs them.
CAMPAY_API_URL=https://demo.campay.net/api
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_WEBHOOK_SECRET=changeme

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@chopnow.app

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

RESEND_API_KEY=
MAIL_FROM=ChopNow Staging <noreply@chopnow.app>

# Tighter than prod's 100 — staging needs to surface regressions during
# pilot smoke tests, where a leaky decorator or a noisy poll loop would
# otherwise be swallowed by the headroom. Window is 60s (see .env.example
# for the per-env tiering rationale).
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=200

# Cloudflare Turnstile bot-protection on /auth/request-otp. Pre-wired
# but inert by default — flip via the STAGING_CAPTCHA_ENABLED secret
# when SIM-farm signal appears. Site key (frontend) lives in Vercel env.
CAPTCHA_ENABLED=false
TURNSTILE_SECRET_KEY=
# Public site key served to the PWA via /auth/captcha-config.
TURNSTILE_SITE_KEY=

# Trust the single Caddy reverse-proxy in front of the API. Without
# this Express reads `127.0.0.1` for every request and per-IP throttles
# collapse into one global bucket — see env.validation.ts for context.
TRUST_PROXY=1

# Real staging origins. The Vercel preview project alias + the production
# domain (apex 308-redirects to app.tchopnow.app). The CD workflow
# overrides this from the STAGING_CORS_ORIGINS secret at apply time —
# this default is just documentation for someone reading the template.
CORS_ORIGINS=https://chopnow-app.vercel.app,https://app.tchopnow.app

# Sentry / observability (Phase O1). All optional — SDK no-ops without
# a DSN. The CD workflow renders SENTRY_DSN from STAGING_SENTRY_DSN secret.
SENTRY_DSN=__from_STAGING_SENTRY_DSN__
SENTRY_ENVIRONMENT=staging
SENTRY_RELEASE=__from_GITHUB_SHA__
SENTRY_TRACES_SAMPLE_RATE=0.1

# Bearer-token gate on /metrics. Required in staging because Caddy
# proxies all paths through to the API — without this, /metrics is
# scrapeable by anyone on the public internet.
METRICS_AUTH_TOKEN=__from_STAGING_METRICS_AUTH_TOKEN__

# Phase O4 — Prisma slow-query log threshold (ms). Default 500.
PRISMA_SLOW_QUERY_MS=500

# Phase O3 — Grafana Cloud Loki log shipping. All optional;
# pino-loki transport is inert when LOKI_URL is empty.
LOKI_URL=__from_STAGING_LOKI_URL__
LOKI_USERNAME=__from_STAGING_LOKI_USERNAME__
LOKI_TOKEN=__from_STAGING_LOKI_TOKEN__

# Phase O2.2 — Grafana Alloy → Prometheus remote-write. Read by
# docker-compose at apply time; passed to the alloy container which
# scrapes api:3001/metrics + remote-writes the result. Token reuses
# STAGING_LOKI_TOKEN since the access policy covers both scopes.
PROM_REMOTE_WRITE_URL=__from_STAGING_PROM_URL__
GRAFANA_USERNAME=__from_STAGING_PROM_USERNAME__
GRAFANA_TOKEN=__from_STAGING_LOKI_TOKEN__

# Tag of the image to pull. Set by the deploy job to staging-<github.sha>.
IMAGE_TAG=__set_by_ci__
