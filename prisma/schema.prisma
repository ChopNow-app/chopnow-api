// ChopNow API — Prisma schema
// Sprint 0 baseline: identity, vendor, catalogue, addresses, landmarks, refresh tokens, KYC.
// Full data model grows per epic. See _bmad-output/planning-artifacts/architecture.md.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // PostGIS pulls in fuzzystrmatch + postgis_tiger_geocoder + postgis_topology
  // automatically on the postgis/postgis Docker image. Declared here so Prisma
  // doesn't treat them as drift on `migrate dev`.
  extensions = [postgis, fuzzystrmatch, postgis_tiger_geocoder, postgis_topology]
}

// =====================================================================
// Enums
// =====================================================================

enum UserRole {
  CONSUMER
  VENDOR
  RIDER
  ADMIN
  SUPER_ADMIN
  OPERATOR
  VIEWER
}

enum OtpChannel {
  WHATSAPP
  SMS
}

enum OtpStatus {
  PENDING
  SENT
  DELIVERED
  VERIFIED
  EXPIRED
  FAILED
}

enum VendorType {
  INFORMAL
  SEMI_FORMAL
  RESTAURANT
}

// Coarse food-vs-drink split for the /vendor/menu category tabs.
// More granular categorization stays in MenuCategory for restaurant-tier
// vendors who want full structured menus.
enum ItemKind {
  FOOD
  DRINK
}

// Three-tier stock signal for the /vendor/menu screen. The boolean
// `isInStock` is retained as a derived field for backward compat with
// the catalogue browse path — the source of truth is now stockLevel.
//   IN_STOCK     — normal availability
//   LOW_STOCK    — vendor flags "running out, may run out soon"; consumer
//                  sees a "stock faible" warning chip on the vendor card
//   OUT_OF_STOCK — equivalent to the legacy isInStock=false (épuisé)
enum StockLevel {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum VendorStatus {
  PENDING_REVIEW
  CORRECTION_REQUESTED
  ACTIVE
  SUSPENDED
  REJECTED
}

enum RiderVehicleType {
  MOTO
  BICYCLE
  CAR
  ON_FOOT
}

enum RiderStatus {
  PENDING_REVIEW
  CORRECTION_REQUESTED
  ACTIVE
  SUSPENDED
  REJECTED
}

// Epic 3 — order lifecycle.
// PENDING       — cart submitted, payment not yet completed (cash always
//                 lands here too until vendor accepts).
// CONFIRMED     — MoMo payment confirmed by Campay webhook; awaiting vendor.
// ACCEPTED      — vendor accepted the order; dispatch starts.
// IN_PREP       — vendor toggled "in kitchen" (optional intermediate state).
// READY_PICKUP  — food ready, rider can collect.
// PICKED_UP     — rider has the food, en route to client.
// DELIVERED     — terminal happy state.
// CANCELLED     — terminal: client cancellation, refund processed (or
//                 cash never paid).
// REFUSED       — terminal: vendor rejected before accepting; refund processed.
// EXPIRED       — terminal: vendor never responded within timeout window.
enum OrderStatus {
  PENDING
  CONFIRMED
  ACCEPTED
  IN_PREP
  READY_PICKUP
  PICKED_UP
  DELIVERED
  CANCELLED
  REFUSED
  EXPIRED
}

enum PaymentMethod {
  MTN_MOMO
  ORANGE_MONEY
  // @deprecated 2026-05-18 — pilot is MoMo-only, no COD product. Kept in
  // the enum to avoid a Postgres enum-removal migration during the
  // pilot launch window; will be dropped in a follow-up once no row
  // references it. See chopnow-api issue #177.
  CASH
}

enum PaymentStatus {
  PENDING // not initiated yet (before /pay call)
  PROCESSING // Campay USSD prompt sent, awaiting webhook
  PAID
  FAILED
  REFUND_PENDING // refund queued (vendor pre-order cancel-after-accept) — Story 3.8 sweeps
  REFUNDED
}

// =====================================================================
// Identity (Stories 1.1, 1.2, 1.4, 1.6, 1.7, 1.8)
// =====================================================================

model User {
  id           String   @id @default(uuid())
  phone        String?  @unique
  email        String?  @unique
  passwordHash String? // admin only — phone-OTP users have no password
  displayName  String?
  role         UserRole @default(CONSUMER)
  isActive     Boolean  @default(true)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  otpLogs           OtpLog[]
  pushSubscriptions PushSubscription[]
  refreshTokens     RefreshToken[]
  addresses         Address[]
  vendor            Vendor?
  rider             Rider?
  orders            Order[]
  orderRatings      OrderRating[]
  passwordResets    AdminPasswordReset[]

  @@index([phone])
  @@index([role])
  @@map("users")
}

// Story 1.1: OTP delivery audit log
model OtpLog {
  id                String     @id @default(uuid())
  userId            String?
  user              User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  phone             String
  channel           OtpChannel
  status            OtpStatus  @default(PENDING)
  codeHash          String
  attempts          Int        @default(0)
  expiresAt         DateTime
  deliveredAt       DateTime?
  verifiedAt        DateTime?
  failedReason      String?
  // Twilio message SID — populated after messages.create() returns. Used by the
  // status webhook (POST /api/twilio/status) to reconcile real delivery state.
  providerMessageId String?    @unique
  createdAt         DateTime   @default(now())

  @@index([phone, createdAt])
  @@index([userId])
  @@map("otp_logs")
}

// Story 1.2: Refresh token rotation + Story 1.7 revocation cascade
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// Story 1.12: Admin password reset (one-time tokens)
model AdminPasswordReset {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("admin_password_resets")
}

// Story 1.11: Web Push subscriptions (VAPID)
model PushSubscription {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceFingerprint String
  endpoint          String
  p256dh            String
  auth              String
  createdAt         DateTime @default(now())
  lastUsedAt        DateTime @default(now())

  @@unique([userId, deviceFingerprint])
  @@index([userId])
  @@map("push_subscriptions")
}

// =====================================================================
// Geography (Story 2.15: Landmarks · Story 3.2: Addresses)
// =====================================================================

// Story 2.15: Landmark = quartier + named point of reference (Carrefour, Mosquée, etc.).
// Drives the address picker and dispatcher rough-zone matching.
model Landmark {
  id        String                                @id @default(uuid())
  quartier  String
  name      String
  // PostGIS POINT — managed via raw SQL in migrations; Prisma sees it as Unsupported.
  // For type-safe access, services use $queryRaw with ST_AsGeoJSON.
  location  Unsupported("geography(Point, 4326)")
  isActive  Boolean                               @default(true)
  createdAt DateTime                              @default(now())
  updatedAt DateTime                              @updatedAt

  addresses Address[]

  @@unique([quartier, name])
  @@index([quartier])
  @@map("landmarks")
}

// Story 3.2: Consumer / vendor / rider addresses.
// landmarkId is optional — a saved address can be a free-form description + GPS point.
model Address {
  id          String                                @id @default(uuid())
  userId      String
  user        User                                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String? // e.g. "Maison", "Bureau"
  description String? // free-form, e.g. "Maison rouge à côté de la pharmacie"
  quartier    String?
  landmarkId  String?
  landmark    Landmark?                             @relation(fields: [landmarkId], references: [id])
  location    Unsupported("geography(Point, 4326)")
  // Phone the rider will call if lost. Saved separately from the user's main
  // phone so a client can deliver to e.g. a partner's home with their phone.
  phone       String?
  isDefault   Boolean                               @default(false)
  createdAt   DateTime                              @default(now())
  updatedAt   DateTime                              @updatedAt

  @@index([userId])
  @@index([landmarkId])
  @@map("addresses")
}

// =====================================================================
// Catalogue (Epic 2)
// =====================================================================

model Vendor {
  id               String                                @id @default(uuid())
  userId           String                                @unique
  user             User                                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  // Owner / gérant — collected at onboarding for KYC and customer-service.
  // Nullable to preserve existing vendor rows that predate the field.
  ownerName        String?
  description      String?
  type             VendorType
  status           VendorStatus                          @default(PENDING_REVIEW)
  quartier         String
  pointOfReference String?
  // Optional landmark for fast geo joins; free-form quartier kept for legacy informal vendors.
  landmarkId       String?
  // PostGIS POINT — vendor pickup location.
  location         Unsupported("geography(Point, 4326)")
  whatsappPhone    String
  momoPhone        String
  // Display badge: "Cuisine locale 🍲" / "Maquis 🍽️" / "Restaurant 🍽️"
  badge            String?
  // Story 2.4 — vendor open/closed flag. Toggled in 1 tap from the dashboard
  // (informal) or via cron based on `hours` (restaurant, cron landing later).
  // Catalogue browse (Story 2.5) hides vendors with isOpen=false from Plan 1/2
  // and shows them only on explicit "all vendors" view.
  isOpen           Boolean                               @default(false)
  // Story 2.4 — per-day opening hours (RESTAURANT only; INFORMAL relies on
  // the isOpen toggle). Shape: { mon: { open: "07:30", close: "21:00" }, ... }
  // Days that are absent or null = closed that day. JSON keeps the schema
  // simple at the cost of cross-row queryability — fine for MVP, the cron
  // only reads vendor-by-vendor.
  hours            Json?
  // Daily order capacity declared at onboarding ( <10 / 10-30 / >30 → 8 / 30 / 50 )
  declaredCapacity Int?
  // Commission rate as a fraction — overridable per vendor by admin
  commissionRate   Decimal                               @default(0.10) @db.Decimal(5, 4)
  // Profile photo + cover photo URLs (Cloudflare R2)
  profilePhotoUrl  String?
  coverPhotoUrl    String?

  // Restaurant KYC — required only when type=RESTAURANT (DTO enforces via
  // @ValidateIf). NULL for INFORMAL + SEMI_FORMAL vendors. Stored as plain
  // text columns (no FK to a separate table) because they're admin-review
  // only during pilot; if a future regulatory regime makes them queryable
  // (e.g. invoice generation needs the RCCM verbatim), the same column is
  // already addressable. Enseigne photo lives in R2 under `vendor-kyc/`.
  rccmNumber       String?
  niuNumber        String?
  enseignePhotoUrl String?

  // Pre-orders (#187 — v1, INFORMAL-only by default).
  // True = consumer cart shows "Plus tard" picker; createOrder accepts scheduledFor.
  // Default false; flipped true automatically when type=INFORMAL at submission.
  // Admin can toggle per-vendor — gate is per-row, NOT per-type, so future
  // semi-formal / restaurant opt-in is one row change with no code edit.
  acceptsPreOrders Boolean @default(false)

  // Validation lifecycle
  submittedAt     DateTime  @default(now())
  validatedAt     DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  categories      MenuCategory[]
  items           Item[]
  orders          Order[]
  ratings         OrderRating[]
  penalties       VendorPenalty[]
  payouts         VendorPayout[]
  cashoutRequests VendorCashoutRequest[]

  @@index([status])
  @@index([type])
  @@index([quartier])
  @@map("vendors")
}

model MenuCategory {
  id        String   @id @default(uuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items Item[]

  @@unique([vendorId, name])
  @@index([vendorId])
  @@map("menu_categories")
}

model Item {
  id                 String        @id @default(uuid())
  orderItems         OrderItem[]
  vendorId           String
  vendor             Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId         String?
  category           MenuCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name               String
  description        String?
  // Price in XAF (FCFA) — integer, no decimals (smallest unit on Cameroon market is 5 FCFA)
  priceXAF           Int
  photoUrl           String?
  isAvailable        Boolean       @default(true)
  // Story 2.10: rupture stock toggle — derived from stockLevel for legacy
  // catalogue paths; keep in sync via Prisma updates on stockLevel changes.
  isInStock          Boolean       @default(true)
  // Three-tier source of truth for stock (Story 2.10 follow-up — menu screen).
  // OUT_OF_STOCK is identical to isInStock=false; LOW_STOCK is the new
  // intermediate state that surfaces a "stock faible" warning on the
  // consumer side without hiding the item.
  stockLevel         StockLevel    @default(IN_STOCK)
  // FOOD by default; vendor toggles per-item in the menu editor. Powers
  // the /vendor/menu category tabs (Tout / Plats / Boissons) and the
  // consumer-side category filter on the vendor detail page later.
  kind               ItemKind      @default(FOOD)
  preparationMinutes Int? // average prep time, used by dispatch ETA
  sortOrder          Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([vendorId])
  @@index([categoryId])
  @@map("items")
}

// =====================================================================
// Orders (Epic 3)
// =====================================================================

model Order {
  id       String      @id @default(uuid())
  // Short human-readable code (e.g. "TC-A23F4") — shown to client + vendor.
  code     String      @unique
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  vendorId String
  vendor   Vendor      @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  status   OrderStatus @default(PENDING)

  // Money — all in XAF integer (no decimals; XAF smallest unit is 5 but we
  // round to whole FCFA for orders).
  subtotalXAF    Int
  deliveryFeeXAF Int
  totalXAF       Int
  noteForVendor  String? @db.VarChar(120)

  // Finance snapshots (ADR-0005). commissionRate is snapshotted at order
  // creation from Vendor.commissionRate AT THAT MOMENT — never recomputed,
  // so tier flips don't rewrite history. commissionXAF / riderShareXAF /
  // platformFeeXAF are computed at payment confirmation and stay on the
  // row for the lifetime of the order. payoutId is set when the order is
  // included in a settled VendorPayout (S2+).
  commissionRate Decimal @db.Decimal(5, 4)
  commissionXAF  Int?
  riderShareXAF  Int?
  platformFeeXAF Int?
  payoutId       String?

  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus @default(PENDING)
  // Provider transaction reference (Campay txn id). Unique so a webhook
  // can't double-credit an order on retry.
  paymentReference String?       @unique
  payerPhone       String?

  // Delivery address — snapshotted inline. We don't FK to `addresses`
  // because the client can edit / delete the saved address later and that
  // shouldn't break our order audit trail. Story 3.2's landmark goes here too.
  deliveryLat         Float
  deliveryLng         Float
  deliveryQuartier    String
  deliveryLandmark    String?
  deliveryDescription String?
  deliveryPhone       String

  // Story 4.13 — pickup + delivery confirmation codes. Each is 4 digits, set
  // at order creation. Rider reads pickupCode from the vendor and deliveryCode
  // from the consumer; both are submitted on the corresponding state
  // transition. Prevents a rider from marking a step done without actually
  // being there.
  pickupCode   String @db.VarChar(4)
  deliveryCode String @db.VarChar(4)

  // Refusal / cancellation context — populated when status enters a
  // terminal-failure state.
  refusalReason String?

  // Story 4.1 — assigned rider. Null until dispatch picks one and the
  // rider claims the order. CASCADE on rider delete would be wrong (we
  // want to keep audit), so the FK uses SET NULL.
  riderId String?
  rider   Rider?  @relation(fields: [riderId], references: [id], onDelete: SetNull)

  // Lifecycle timestamps — null until the corresponding transition fires.
  placedAt    DateTime  @default(now())
  paidAt      DateTime?
  acceptedAt  DateTime?
  refusedAt   DateTime?
  preparedAt  DateTime?
  assignedAt  DateTime? // Story 4.1 — rider claimed this order
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  // Refund flow (S3 / #90). Populated by RefundProcessor when it claims
  // the row (refundInitiatedAt) and again when Campay returns a
  // reference (refundCampayRef). The Campay webhook eventually flips
  // paymentStatus REFUND_PENDING → REFUNDED and stamps refundedAt.
  refundInitiatedAt   DateTime?
  refundCampayRef     String?   @unique
  refundedAt          DateTime?
  refundFailureReason String?

  // Vendor acceptance SLA — set on order creation to placedAt + ACCEPTANCE_TTL_SECONDS
  // for immediate orders. For pre-orders this column stays NULL at create time and
  // is set by PreOrderPromotionService when scheduledFor - PRE_ORDER_NOTIFICATION_LEAD
  // arrives (so the vendor's 60s countdown matches "when they can act on it").
  // The OrdersExpiryService cron's `acceptanceDeadlineAt < now` filter naturally
  // skips rows with NULL (Postgres NULL < anything is false).
  acceptanceDeadlineAt DateTime?

  // Pre-orders (#187 — v1, INFORMAL-only by default).
  // NULL = immediate delivery (today's flow). Set = pre-order; vendor isn't
  // notified until scheduledFor - PRE_ORDER_NOTIFICATION_LEAD via the
  // PreOrderPromotionService cron. Dispatch is deferred similarly.
  scheduledFor DateTime?

  // Story 3.14 — client-supplied key so a re-tried POST /orders doesn't
  // create a duplicate. Scoped per user (composite uniqueness below).
  idempotencyKey String?

  items   OrderItem[]
  rating  OrderRating?
  penalty VendorPenalty?

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([vendorId])
  @@index([riderId])
  @@index([status])
  @@index([placedAt])
  // Pre-order promotion cron sweep: WHERE scheduledFor != NULL AND scheduledFor <= now
  // is the hot path; partial index keeps it tight when the table grows.
  @@index([scheduledFor])
  @@index([vendorId, scheduledFor])
  @@map("orders")
}

// =====================================================================
// Pre-order vendor penalty ledger (Story 3.x — feature #187)
// =====================================================================
// Created when a vendor cancels a pre-order AFTER accepting it (cancellation
// before acceptance is free). Bookkeeping row only at this stage — Story 7.x
// (Finance & Cashout) will read unsettled rows and net them against the
// vendor's next MoMo payout. Admin reviews via the validation queue in v1.

enum VendorPenaltyReason {
  PRE_ORDER_VENDOR_CANCEL_AFTER_ACCEPT
}

model VendorPenalty {
  id        String              @id @default(uuid())
  vendorId  String
  vendor    Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  // One penalty per order — re-cancellation isn't possible (status guard) so
  // this constraint also enforces no double-charge on the same incident.
  orderId   String              @unique
  order     Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reason    VendorPenaltyReason
  amountXAF Int
  createdAt DateTime            @default(now())
  // NULL until the Finance module deducts this from a payout (Story 7.x).
  settledAt DateTime?

  @@index([vendorId, settledAt])
  @@map("vendor_penalties")
}

// Story 3.9 — post-delivery rating. One per order (unique on orderId).
// Both scores are required when the consumer submits; we don't show partial
// ratings publicly.
model OrderRating {
  id          String   @id @default(uuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorScore Int // 1..5
  riderScore  Int // 1..5 (null-ish for ON_FOOT-only orders is future)
  comment     String?  @db.VarChar(200)
  createdAt   DateTime @default(now())

  @@index([vendorId])
  @@index([userId])
  @@map("order_ratings")
}

// Line items — snapshot price + name at order time so menu changes after
// purchase never rewrite history.
model OrderItem {
  id      String  @id @default(uuid())
  orderId String
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId  String?
  item    Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  nameSnapshot     String
  priceXAFSnapshot Int
  quantity         Int
  lineXAF          Int

  // Vendor-side "this article is plated" checkbox on the /vendor/preparation
  // screen. The first item flipping prepared also flips Order.status from
  // ACCEPTED to IN_PREP; once all items are prepared, the vendor's
  // "Commande prête" CTA flips status to READY_PICKUP.
  preparedAt DateTime?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

// =====================================================================
// Riders / KYC (Story 1.4)
// =====================================================================

model Rider {
  id               String                                 @id @default(uuid())
  userId           String                                 @unique
  user             User                                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType      RiderVehicleType
  preferredZone    String?
  status           RiderStatus                            @default(PENDING_REVIEW)
  // KYC photo URLs (Cloudflare R2 private bucket)
  idCardPhotoUrl   String?
  selfiePhotoUrl   String?
  vehiclePhotoUrl  String?
  licensePlate     String?                                @unique
  momoPhone        String
  // Reliability score, 0..100. Bumped/decreased by Story 4.6 logic.
  reliabilityScore Int                                    @default(80)
  // Story 4.1 — online flag (rider has tapped "Je commence" in the app).
  // Story 4.4 — last GPS ping; `stale` if lastSeenAt > 60s old.
  isOnline         Boolean                                @default(false)
  lastLocation     Unsupported("geography(Point, 4326)")?
  lastSeenAt       DateTime?
  // Validation lifecycle
  submittedAt      DateTime                               @default(now())
  validatedAt      DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime                               @default(now())
  updatedAt        DateTime                               @updatedAt

  orders  Order[]
  payouts RiderPayout[]

  @@index([status])
  @@index([vehicleType])
  @@index([isOnline])
  @@map("riders")
}

// =====================================================================
// Finance — ledger + payouts (Epic 7 — ADR-0005)
// =====================================================================
// Append-only double-entry ledger. Every money movement writes paired
// entries (debit + credit) that sum to zero by `eventId`. Service-layer
// invariant — never write a single entry; always call
// LedgerService.recordTransaction(eventId, entries[]).
//
// Sign convention: amountXAF is signed. Negative = credit to the account,
// positive = debit. Reporting layer flips the sign for liability accounts
// at read time so balances read intuitively.

enum LedgerAccount {
  CUSTOMER_ESCROW // liability — customer paid, platform holds until delivery
  VENDOR_PAYABLE // liability — owed to vendor for delivered orders
  RIDER_PAYABLE // liability — owed to rider for completed deliveries
  PLATFORM_REVENUE // income — commission + delivery margin earned
  PLATFORM_RESERVE // asset — kept on platform for refunds/disputes/penalties
  CAMPAY_FLOAT // asset — funds Campay holds on our behalf
  REFUND_PAYABLE // liability — refund owed back to a customer
}

enum LedgerEventType {
  PAYMENT_RECEIVED
  ORDER_DELIVERED
  REFUND_ISSUED
  VENDOR_PAYOUT
  RIDER_PAYOUT
  PENALTY_APPLIED
  ADJUSTMENT // admin manual entry — description is required
}

enum PayoutStatus {
  PENDING // computed, not yet sent to Campay
  IN_FLIGHT // Campay transfer initiated, awaiting webhook
  PAID // confirmed paid by Campay
  FAILED // Campay rejected; ops escalation
  CANCELLED // admin reversed before in-flight
}

model LedgerEntry {
  id          String          @id @default(uuid())
  // Groups legs of a single transaction. All entries with the same
  // eventId must sum to zero (enforced by LedgerService.recordTransaction).
  eventId     String
  eventType   LedgerEventType
  account     LedgerAccount
  // Signed XAF — never zero. Sum-to-zero invariant is checked at write.
  amountXAF   Int
  // At least one of the FK fields is required at the service layer.
  orderId     String?
  vendorId    String?
  riderId     String?
  payoutId    String?
  refundId    String?
  // Human-readable description, shown in the admin financial dashboard.
  // Required when eventType = ADJUSTMENT.
  description String?
  createdAt   DateTime        @default(now())

  @@index([eventId])
  @@index([account, createdAt])
  @@index([vendorId, createdAt])
  @@index([riderId, createdAt])
  @@index([orderId])
  @@map("ledger_entries")
}

// Campay webhook dedup table (ADR-0005, S3 / chopnow-api#88).
// Persistence-layer idempotency for Campay callbacks. INSERT-first
// pattern: the (eventType, reference) unique constraint causes the
// second webhook for the same Campay reference to fail with a known
// error, which the dedup service converts into a "not-first" signal.
// State-mutating logic only runs when we win the insert race.
enum CampayWebhookEventType {
  COLLECT // inbound payment status callback (Order)
  TRANSFER // outbound payout status callback (VendorPayout / RiderPayout)
  REFUND // refund status callback (S3 #90 future)
}

model CampayWebhookEvent {
  id          String                 @id @default(uuid())
  eventType   CampayWebhookEventType
  reference   String // Campay reference (or external_reference fallback)
  // Full webhook body for audit. JSON keeps it queryable without
  // schema migrations every time Campay adds a field.
  payload     Json
  // Short string describing what we did first time around: e.g.
  // "order_paid", "payout_failed", "no_match", "ignored_non_terminal".
  result      String?
  processedAt DateTime               @default(now())

  // The hot path: unique on (eventType, reference) so the second
  // webhook for the same event becomes a constraint violation, which
  // CampayWebhookDedupService converts into a no-op.
  @@unique([eventType, reference])
  @@index([eventType, processedAt])
  @@map("campay_webhook_events")
}

enum CashoutRequestStatus {
  PENDING_APPROVAL // vendor has requested, admin hasn't acted
  APPROVED // admin approved, VendorPayout created
  REJECTED // admin declined (reason captured)
  CANCELLED // vendor or admin cancelled before approval
}

// On-demand cashout request for INFORMAL vendors (ADR-0005, 7.2b).
// Separate from VendorPayout to keep the strict (vendorId, periodStart)
// uniqueness clean — a rejected request shouldn't permanently block a
// future request for that period.
model VendorCashoutRequest {
  id               String               @id @default(uuid())
  vendorId         String
  vendor           Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  // Balance at the moment the vendor tapped "Demander virement". Snapshotted
  // for admin transparency; final payout uses the live balance at approval.
  requestedXAF     Int
  status           CashoutRequestStatus @default(PENDING_APPROVAL)
  // Set when admin acts.
  approvedAt       DateTime?
  approvedByUserId String?
  rejectedAt       DateTime?
  rejectionReason  String?
  // FK to the VendorPayout created on approval; null until then or if rejected.
  payoutId         String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([vendorId, status])
  @@index([status, createdAt])
  @@map("vendor_cashout_requests")
}

model VendorPayout {
  id             String       @id @default(uuid())
  vendorId       String
  vendor         Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  // Period covered. For weekly: Sun-prev 02:00 → Sat-this 23:59. For
  // on-demand: periodStart = earliest un-paid order's paidAt, periodEnd
  // = request time.
  periodStart    DateTime
  periodEnd      DateTime
  // Money breakdown — all XAF integers.
  grossXAF       Int // sum of order subtotals in period
  commissionXAF  Int // platform commission deducted
  penaltyXAF     Int          @default(0) // sum of VendorPenalty rows applied
  adjustmentsXAF Int          @default(0) // admin manual adjustments (signed)
  netXAF         Int // grossXAF - commissionXAF - penaltyXAF + adjustmentsXAF
  momoPhone      String
  campayRef      String?      @unique
  status         PayoutStatus @default(PENDING)
  failureReason  String?
  scheduledFor   DateTime // when the cron picked it up OR request time
  sentAt         DateTime?
  paidAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // One payout per (vendor, period). Re-running the cron is idempotent.
  @@unique([vendorId, periodStart])
  @@index([status, scheduledFor])
  @@index([vendorId, periodStart])
  @@map("vendor_payouts")
}

model RiderPayout {
  id             String       @id @default(uuid())
  riderId        String
  rider          Rider        @relation(fields: [riderId], references: [id], onDelete: Restrict)
  // Period for a daily batch: previous day 00:00 → 23:59 Africa/Douala.
  periodStart    DateTime
  periodEnd      DateTime
  grossXAF       Int // sum of rider shares for completed deliveries
  adjustmentsXAF Int          @default(0)
  netXAF         Int // grossXAF + adjustmentsXAF (no commission — rider earns share directly)
  momoPhone      String
  campayRef      String?      @unique
  status         PayoutStatus @default(PENDING)
  failureReason  String?
  scheduledFor   DateTime
  sentAt         DateTime?
  paidAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([riderId, periodStart])
  @@index([status, scheduledFor])
  @@index([riderId, periodStart])
  @@map("rider_payouts")
}
